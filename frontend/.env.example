# Optional. Default proxy target is http://127.0.0.1:8000.
BACKEND_URL=http://127.0.0.1:8000
# For a separately hosted frontend, set a reachable HTTPS API origin at build time.
# VITE_API_BASE_URL=https://your-api.example.com
# Never put cloud, database or LLM secrets in a VITE_ variable.

# Optional: send sign-in, the health check, "add member" or the dashboard through Boomi APIs.
# VITE_BOOMI_LOGIN=true   (POST /ws/rest/login/v1/login/)
# Put the real values in frontend/.env.local (git-ignored). The Boomi login is added by the dev proxy, not the browser.
# VITE_BOOMI_HEALTH=true
# VITE_BOOMI_MEMBERS=true
# VITE_BOOMI_DASHBOARD=true
# BOOMI_BASE_URL=https://c01-sg.integrate.boomi.com
# BOOMI_USERNAME=
# BOOMI_TOKEN=
