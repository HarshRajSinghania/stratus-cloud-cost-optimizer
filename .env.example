# Local SQLite database (default). The path is relative to the backend directory.
# For shared deployments, replace this with the PostgreSQL URL documented in README.md.
DATABASE_URL=sqlite+pysqlite:///../cloud_optimizer.db
SECRETS_KEY=replace_with_a_fernet_key
SESSION_HOURS=12
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=60
# Browser origins allowed to call the API. Use * to allow frontends on other machines (tokens are sent as
# Bearer headers, not cookies, so this does not expose sessions). List exact origins for a stricter setup.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
